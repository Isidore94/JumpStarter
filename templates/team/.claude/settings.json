{
  "permissions": {
    "allow": [
      "Bash({{TEST_CMD}}*)",
      "Bash({{LINT_CMD}}*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git worktree *)",
      "Bash(git checkout -b {{BRANCH_PREFIX}}*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin {{BRANCH_PREFIX}}*)",
      "Bash(git push origin {{BRANCH_PREFIX}}*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D *)",
      "Bash(git stash*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
