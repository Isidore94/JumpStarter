@@ -221,3 +221,15 @@ def test_closing_trade_without_opening_is_flagged_and_opening_short_is_not():
     ]
     res = run(rows, FxTable({}, fallback=2.0))
     assert len(res.warnings) == 1 and "NVDA 2026-01-09 P 180.00" in res.warnings[0] and "earlier statement" in res.warnings[0]
+
+
+def test_commissions_tracked_through_cost_long_partial_and_short(fx):
+    # Long: buy 10 @100 (comm 1), sell 5 @110 (comm 1): half the buy commission rides into this sale.
+    res = run([tx(date(2026, 1, 5), 10, 100.0), tx(date(2026, 1, 6), -5, 110.0)], fx)
+    (ev,) = res.events
+    assert ev.commission_cad == pytest.approx((0.5 + 1) * 2.0)
+    assert ev.gain_cad + ev.commission_cad == pytest.approx(5 * (110 - 100) * 2.0)
+    # Short: sell 10 @50 (comm 1), cover 10 @45 (comm 1).
+    res = run([tx(date(2026, 2, 5), -10, 50.0, symbol="X"), tx(date(2026, 2, 6), 10, 45.0, symbol="X")], fx)
+    (ev,) = res.events
+    assert ev.commission_cad == pytest.approx(4.0) and ev.gain_cad + ev.commission_cad == pytest.approx(100.0)
