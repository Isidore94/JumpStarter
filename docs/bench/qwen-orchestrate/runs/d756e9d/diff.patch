     assert "Taxes owed" in md
 
 
+def test_pnl_before_commissions_and_commissions_on_closed(ledger):
+    load_all(ledger)
+    rep = build_report(ledger, 2026, as_of=date(2026, 4, 1))
+    r = 1.37  # fixture FX rate: every USD figure converts at 1.37
+    # Taxable closes in 2026: AAPL bought 100@150 (comm 4.95, Questrade) + 50@152 (comm 1.00, IBKR),
+    # sold 100@160 (comm 4.95) + 50@161 (comm 1.00); TSLA short -20@200 (comm 1.00) covered +20@190 (comm 1.00).
+    # SHOP.TO and the open option buys never close, so they contribute nothing.
+    aapl_before = (16000 + 8050 - 15000 - 7600) * r  # 1450.00 USD gross proceeds minus gross cost
+    tsla_before = (4000 - 3800) * r  # 200.00 USD
+    aapl_comm = (4.95 + 1.00 + 4.95 + 1.00) * r  # buy commissions (in ACB) + sell commissions
+    tsla_comm = (1.00 + 1.00) * r  # short-open commission (in pool) + cover commission
+    # TFSA: NVDA 10@100 (comm 4.95) sold 10@130 (comm 4.95)
+    nvda_before = (1300 - 1000) * r  # 300.00 USD
+    nvda_comm = (4.95 + 4.95) * r
+    assert rep.taxable_pnl_before_commissions == pytest.approx(aapl_before + tsla_before)
+    assert rep.taxable_commissions_on_closed == pytest.approx(aapl_comm + tsla_comm)
+    assert rep.total_pnl_before_commissions == pytest.approx(aapl_before + tsla_before + nvda_before)
+    assert rep.commissions_on_closed == pytest.approx(aapl_comm + tsla_comm + nvda_comm)
+    # P&L before commissions minus commissions equals today's after-commission P&L, all accounts and taxable share.
+    assert rep.total_pnl_before_commissions - rep.commissions_on_closed == pytest.approx(rep.total_pnl)
+    assert rep.taxable_pnl_before_commissions - rep.taxable_commissions_on_closed == pytest.approx(rep.taxable_pnl)
+    # Tax side unchanged: after-commission P&L is still what the tax figures are built from.
+    assert rep.taxable_pnl == pytest.approx(((16000 + 8050 - 15000 - 7600 - 4.95 - 1.00 - 4.95 - 1.00) + (4000 - 3800 - 1.00 - 1.00)) * r)
+    assert rep.total_pnl == pytest.approx(rep.taxable_pnl + rep.tfsa_pnl)
+
+
 def test_capital_report_and_coverage_gaps(ledger):
     load_all(ledger)
     ledger.set_setting("tax_treatment", "CAPITAL")
