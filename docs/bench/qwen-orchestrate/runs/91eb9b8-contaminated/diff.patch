+def _tables_populated(db: Database) -> bool:
+    """Is every SDE table this build should have filled actually filled?
+
+    The build stamp alone is not proof the load is complete. When a release
+    adds a table — `sde_stargates` and `sde_npc_stations` did — a lake loaded
+    by the older code carries the same build number with the new tables empty,
+    and the build-equality no-op then refuses to fix it forever. The symptom
+    is silent and far away: routing reports every system as "not in the
+    stargate graph" and the hauling scanner returns nothing at all.
+    Emptiness is the check.
+    """
+    for table in SDE_TABLES:
+        if not db.conn.execute(f"SELECT COUNT(*) AS n FROM {table}").fetchone()["n"]:
+            return False
+    return True
+
