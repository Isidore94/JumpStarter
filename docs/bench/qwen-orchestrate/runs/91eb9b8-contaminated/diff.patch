+# -- 4. the build stamp is not proof the load is complete -------------------
+#
+# The refresh decides "no-op" on the stored build number alone. That holds
+# only while every table the load fills actually holds rows: a release that
+# adds a table (H1a's stargates and stations did) leaves a previously loaded
+# lake stamped with the current build and the new tables empty, and routing
+# then reports every system as "not in the stargate graph" while the hauling
+# scanner returns nothing at all. Emptiness, not the stamp, is what the
+# no-op may trust. The network is stubbed at the two seams the CLI hits:
+# the latest-build lookup and the download.
+
+
+def test_an_empty_stargate_table_still_forces_a_reload(tmp_path, config, db, monkeypatch):
+    from evescreener import sde as sde_module
+
+    bundle = _bundle(tmp_path)
+    load_sde(config, db, bundle_path=bundle)  # stamps the build
+    db.conn.execute("DELETE FROM sde_stargates")
+
+    seen = {}
+
+    def fake_download(cfg, build, destination, client=None):
+        seen["build"] = build
+        seen["destination"] = destination
+        return bundle
+
+    monkeypatch.setattr(sde_module, "latest_build", lambda *a, **k: 3478781)
+    monkeypatch.setattr(sde_module, "download_bundle", fake_download)
+
+    result = load_sde(config, db)
+    assert seen["build"] == 3478781, "the reload must go through the download path"
+    assert result.downloaded is True
+    assert result.stargates == 2, "an empty table means the load is incomplete, stamp or no stamp"
+    assert sorted(db.stargate_edges()) == [(30000142, 30000144), (30000144, 30000142)]
+
+
