+
+def find_internals_citations(text: str) -> list[str]:
+    """INTERNALS entry names cited in ``CLAUDE.md``, first-seen order, deduplicated.
+
+    Citations inside HTML comments are examples, not rules, and a cited name may wrap
+    onto the next line - it is folded back to one line before matching.
+    """
+    seen: list[str] = []
+    for match in INTERNALS_CITATION_RE.finditer(_strip_html_comments(text)):
+        name = re.sub(r"\s+", " ", match.group(1)).strip()
+        if name and name not in seen:
+            seen.append(name)
+    return seen
+
+
+def internals_headings(text: str) -> list[str]:
+    """Leading text of each ``##`` heading with its trailing ``(date, reason)`` suffix
+    removed: the text a citation is matched against. ``###`` sub-headings are not
+    entries and are not matched."""
+    names: list[str] = []
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped.startswith("##") or stripped.startswith("###"):
+            continue
+        title = stripped.lstrip("#").strip()
+        title = re.sub(r"\s*\([^()]*\)\s*$", "", title).strip()
+        if title:
+            names.append(title)
+    return names
+
