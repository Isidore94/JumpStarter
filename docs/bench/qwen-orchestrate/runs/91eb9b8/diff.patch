+# -- 4. the same-build refresh, when the map is only half built -------------
+#
+# The build stamp records a build, not a completed load. An older load can
+# stamp the current build while leaving a map table empty (an older schema's
+# `CREATE TABLE IF NOT EXISTS` does exactly that on the operator's lake), and
+# a refresh that trusts the stamp alone would skip forever, leaving the router
+# with an empty map that answers NO_ROUTE to every scan. These tests keep the
+# network closed: the build lookup and the download are stubbed, so what runs
+# is the refresh's own decision about whether to reload.
+
+
+def _prime_same_build_map_except(db, table: str | None) -> None:
+    """A load stamped the current build but left `table` empty.
+
+    `table=None` fills all five SDE tables — the state a healthy load leaves,
+    which is what the cheap no-op path must still see.
+    """
+    db.replace_market_groups([(18, None, "Minerals")])
+    db.replace_types([(34, "Tritanium", 18, 0.01, 1.0, 1)])
+    db.replace_solar_systems(
+        [
+            (30000142, 10000002, "Jita", 0.945913),
+            (30000144, 10000002, "Perimeter", 0.95),
+        ]
+    )
+    if table != "sde_stargates":
+        db.replace_stargates([(50000056, 30000142, 30000144), (50000057, 30000144, 30000142)])
+    if table != "sde_npc_stations":
+        db.replace_npc_stations(
+            [
+                (60003760, 30000142, 1000035, 14, None),
+                (60003761, 30000144, 1000003, 5, None),
+            ]
+        )
+    db.set_meta("sde_build", "3478781")
+
+
+def _stub_sde_network(monkeypatch, tmp_path: Path, *, bundle: Path | None = None) -> dict:
+    """Close `load_sde`'s two network doors: the build lookup and the download.
+
+    The download answers with a locally built bundle (or `bundle` when given)
+    and counts its calls, so a test can prove whether the refresh reloaded at
+    all, and with which build it reloaded.
+    """
+    calls = {"downloads": 0, "builds": []}
+
+    def fake_latest_build(config, client=None):
+        return 3478781
+
+    def fake_download(config, build, destination, client=None):
+        calls["downloads"] += 1
+        calls["builds"].append(build)
+        return bundle if bundle is not None else _bundle(tmp_path)
+
+    monkeypatch.setattr("evescreener.sde.latest_build", fake_latest_build)
+    monkeypatch.setattr("evescreener.sde.download_bundle", fake_download)
+    return calls
+
+
+@pytest.mark.parametrize("table", ["sde_stargates", "sde_npc_stations"])
+def test_a_same_build_refresh_reloads_when_a_map_table_is_empty(
+    tmp_path, config, db, monkeypatch, table
+):
+    """An empty SDE table is a broken load the stamp cannot see, so a refresh
+    that finds one reloads the bundle whatever the build says — and the router
+    then reads the map the reload fills."""
+    _prime_same_build_map_except(db, table)
+    # A NO_ROUTE computed against the broken map is a stale answer the reload
+    # must take with it: `route_cache` is keyed by build, not by the map.
+    db.conn.execute(
+        "INSERT INTO route_cache(sde_build, origin, destination, profile,"
+        " avoid_hash, systems, jumps, known, reason, computed_at)"
+        " VALUES(3478781, 30000142, 30000144, 'shortest', 'h', '[]', NULL, 0,"
+        " 'no route', '2026-10-26T00:00:00+00:00')"
+    )
+    calls = _stub_sde_network(monkeypatch, tmp_path)
+    result = load_sde(config, db)
+    assert calls["downloads"] == 1, "the empty table must force the reload"
+    assert calls["builds"] == [3478781], "the reload reuses the build it already stamped"
+    assert result.downloaded is True
+    assert result.stargates == 2
+    assert result.npc_stations == 2
+    assert db.get_meta("sde_build") == "3478781"
+    assert (
+        db.conn.execute(
+            "SELECT COUNT(*) AS n FROM route_cache WHERE sde_build=?", (3478781,)
+        ).fetchone()["n"]
+        == 0
+    ), "a cached route must not outlive the map it was computed on"
+    if table == "sde_stargates":
+        from evescreener.routes import RouteGraph
+
+        graph = RouteGraph.from_db(db)
+        assert graph.route(30000142, 30000144).known is True, (
+            "the reload exists so the router finds the system again"
+        )
